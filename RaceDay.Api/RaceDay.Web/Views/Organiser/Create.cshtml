@model RaceDay.Web.ViewModels.CreateEventViewModel
@{
    ViewData["Title"] = "Create event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1>Create event</h1>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <partial name="_EventFields" model="Model" />

            <h2 class="h4 mt-4">First category</h2>
            <p class="text-muted">You can add more categories after the event is created.</p>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DistanceKM" class="form-label"></label>
                    <input asp-for="DistanceKM" type="number" step="any" class="form-control" />
                    <span asp-validation-for="DistanceKM" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="MaxParticipants" class="form-label"></label>
                    <input asp-for="MaxParticipants" type="number" class="form-control" />
                    <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EntryFee" class="form-label"></label>
                    <input asp-for="EntryFee" type="number" step="any" class="form-control" />
                    <span asp-validation-for="EntryFee" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Create event</button>
            <a asp-action="Events" class="btn btn-outline-dark">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}