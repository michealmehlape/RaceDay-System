@model RaceDay.Web.ViewModels.OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Manage events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Manage events</h1>
    <a asp-action="Create" class="btn btn-primary">Create new event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
else if (Model.Events.Count == 0)
{
    <p>You have not created any events yet.</p>
}
else
{
    <table class="table table-bordered bg-white">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Type</th>
                <th>Location</th>
                <th>Categories</th>
                <th>Enrolments</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Events)
            {
                <tr>
                    <td>@item.EventName</td>
                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@item.EventType</td>
                    <td>@item.Location</td>
                    <td>@item.CategoryCount</td>
                    <td>@item.TotalEnrolments</td>
                    <td>

                        <a asp-action="Enrolments" asp-route-eventId="@item.EventID" class="btn btn-outline-dark btn-sm">Enrolments</a>
                        <a asp-action="Categories" asp-route-eventId="@item.EventID" class="btn btn-outline-dark btn-sm">Categories</a>
                        <a asp-action="Edit" asp-route-id="@item.EventID" class="btn btn-outline-dark btn-sm">Edit</a>
                        <form asp-action="DeleteEvent" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this event?');">
                            <input type="hidden" name="id" value="@item.EventID" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}