@model RaceDay.Web.ViewModels.CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Categories</h1>
        <p class="text-muted mb-0">@Model.EventName</p>
    </div>
    <a asp-action="AddCategory" asp-route-eventId="@Model.EventID" class="btn btn-primary">Add category</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
else if (Model.Categories.Count == 0)
{
    <p>This event has no categories yet. Add one so people can enrol.</p>
}
else
{
    <table class="table table-bordered bg-white">
        <thead>
            <tr>
                <th>Name</th>
                <th>Distance</th>
                <th>Max participants</th>
                <th>Entry fee</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Categories)
            {
                <tr>
                    <td>@item.CategoryName</td>
                    <td>@item.DistanceKM.ToString("0.##") km</td>
                    <td>@item.MaxParticipants</td>
                    <td>R @item.EntryFee.ToString("0.00")</td>
                    <td>
                        <a asp-action="EditCategory" asp-route-eventId="@Model.EventID"
                           asp-route-categoryId="@item.CategoryID" class="btn btn-outline-dark btn-sm">Edit</a>
                        <form asp-action="DeleteCategory" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this category?');">
                            <input type="hidden" name="eventId" value="@Model.EventID" />
                            <input type="hidden" name="categoryId" value="@item.CategoryID" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Events" class="btn btn-outline-dark">Back to events</a>