@model RaceDay.Web.ViewModels.EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1>Edit event</h1>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="EventID" />

            <partial name="_EventFields" model="Model" />

            <p class="text-muted">Distances are managed on the event's categories.</p>

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Events" class="btn btn-outline-dark">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}