@model RaceDay.Web.ViewModels.EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
}

<h1 class="mb-0">Enrolments</h1>
<p class="text-muted">@Model.EventName</p>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

@if (Model.Enrolments.Count == 0)
{
    <p>Nobody has enrolled in this event yet.</p>
}
else
{
    <p>@Model.Enrolments.Count participant(s) enrolled.</p>

    <table class="table table-bordered bg-white">
        <thead>
            <tr>
                <th>Bib</th>
                <th>Participant</th>
                <th>Category</th>
                <th>Enrolled on</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Enrolments)
            {
                <tr>
                    <td>@item.BibNumber</td>
                    <td>@item.ParticipantName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td><span class="status-badge status-@item.Status.ToLower()">@item.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Events" class="btn btn-outline-dark">Back to events</a>