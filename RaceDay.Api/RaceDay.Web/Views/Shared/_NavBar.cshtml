@using Microsoft.AspNetCore.Http
@{
    var loggedIn = Context.Session.GetInt32("UserId") is not null;
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("FullName");
}

<nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
    <div class="container">
        <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Events</a>
                </li>

                @if (role == "Participant")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a>
                    </li>
                }

                @if (role == "Organiser")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                    </li>
                }
            </ul>

            <ul class="navbar-nav align-items-lg-center">
                @if (loggedIn)
                {
                    <li class="nav-item d-flex align-items-center me-lg-3">
                        <span class="text-white me-2">@name</span>
                        <span class="role-pill">@role</span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Join RaceDay</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>